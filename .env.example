# MongoDB Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abgxr7n.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_here

# Unified Same-Origin API (Leave empty for relative calls /api/v1/...)
NEXT_PUBLIC_API_URL=

# Redis Cache (Upstash or local)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
REDIS_URL=redis://127.0.0.1:6379

# Baray Payment Gateway
BARAY_API_KEY=your_baray_api_key
BARAY_SK=your_baray_secret_key
BARAY_IV=your_baray_iv

# KOOMPI Cloud Object Storage
KOOMPI_STORAGE_BASE_URL=https://api-kconsole.koompi.cloud
KOOMPI_STORAGE_API_KEY=your_koompi_bucket_api_key

# KID OAuth Single Sign-On
NEXT_PUBLIC_KID_CLIENT_ID=your_kid_client_id
NEXT_PUBLIC_KID_REDIRECT_URI=http://localhost:3000/auth/kid/callback
KID_CLIENT_ID=your_kid_client_id
KID_CLIENT_SECRET=your_kid_client_secret
KID_REDIRECT_URI=http://localhost:3000/auth/kid/callback
KID_BASE_URL=https://api.kid.koompi.org
